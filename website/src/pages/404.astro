---
import Base from "../layouts/Base.astro";
import { t } from "../i18n";

const dict = t("en");
---

<Base locale="en" title="Not found — Muviss">
  <section class="wrap section center">
    <img src="/icon.svg" alt="" width="96" height="96" />
    <h1 class="section-title">{dict.notFound.title}</h1>
    <p class="lede">{dict.notFound.body}</p>
    <p><a class="btn btn-primary" href="/">{dict.notFound.home}</a></p>
  </section>
</Base>

<style>
  .center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
</style>
