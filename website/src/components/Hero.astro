---
import { links } from "../config/links";
import { t, type Locale } from "../i18n";
import Screenshot from "./Screenshot.astro";
import StoreBadges from "./StoreBadges.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <span class="kicker">{dict.hero.eyebrow}</span>
      <h1>{dict.hero.title}</h1>
      <p class="lede">{dict.hero.lede}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={links.github}>
          <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          {dict.hero.github}
        </a>
        <a class="btn btn-ghost" href="#features">{dict.hero.seeFeatures}</a>
      </div>
      <StoreBadges locale={locale} />
    </div>
    <div class="visual">
      <Screenshot name="detail-seasons" alt={dict.hero.shotAlt} pending={dict.shotPending} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px);
    background: radial-gradient(
      ellipse 80% 60% at 85% 10%,
      color-mix(in srgb, var(--amber) 28%, transparent),
      transparent 70%
    );
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }
  h1 {
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    font-weight: 700;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block: 32px 28px;
  }
  .visual {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
