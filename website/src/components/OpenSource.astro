---
import { links, repoPath } from "../config/links";
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section id="open-source" class="section">
  <div class="wrap card">
    <div>
      <span class="kicker">{dict.openSource.kicker}</span>
      <h2 class="section-title">{dict.openSource.title}</h2>
      <p class="lede">{dict.openSource.body}</p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href={links.github}>{dict.openSource.repo}</a>
      <a class="btn btn-ghost" href={`${links.github}/tree/main/docs/adr`}>{dict.openSource.adrs}</a>
      <a class="btn btn-ghost" href={repoPath("AGENTS.md")}>{dict.openSource.contribute}</a>
    </div>
  </div>
</section>

<style>
  .card {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  @media (max-width: 820px) {
    .card {
      grid-template-columns: 1fr;
    }
  }
</style>
