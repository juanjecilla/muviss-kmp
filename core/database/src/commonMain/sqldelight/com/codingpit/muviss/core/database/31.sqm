-- For you's offline copy (#785). The filename is the version this migrates FROM: 31.sqm takes a v31 database
-- to v32 (fixture 32.db).
--
-- NUMBERING: claimed when the #785 branch opened. 30.sqm (#853) is on develop now, so the chain is whole. If
-- another schema change merges first, the one merging second renumbers; `verifyMigrations` cannot see a collision.
--
-- A cache table, not user data (ADR 0015's family, like `discoverCache` from #724). Nothing to backfill: an
-- upgraded install has no stored For you copy until its first online load.
CREATE TABLE forYouCache (
    cacheKey TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);
