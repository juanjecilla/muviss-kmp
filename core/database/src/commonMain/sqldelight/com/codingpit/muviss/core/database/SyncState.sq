-- What this device knows about its own sync (EPIC 39, ADR 0020). One row,
-- id = 0, created lazily like `syncAccount` and `appSettings`.
--
-- `ownerAccountId` is the account this database's user data belongs to, and the
-- reason the table exists. Nothing recorded whose library the local rows were,
-- so signing out and into a different account pushed the first account's dirty
-- rows into the second and merged the second's clean ones with the first's.
-- Null means no account has ever synced from here, which is every install that
-- predates this table: the first sync adopts its signed-in account, puts every
-- local row on the change-log and does a full reconcile. That is also what makes
-- rewatch history from before `7.sqm` reach the server.
--
-- The rest is the outcome of the last attempt, written by the engine. It is
-- what a background run has to leave behind, because nobody is watching it: a
-- failure that vanishes with the process is a sync that silently stopped.
-- `lastOutcome` is 'SUCCESS' or 'FAILED' (null before the first attempt);
-- `lastError` starts with the failure's reason token (OFFLINE, UNAUTHORISED,
-- SERVER, UNKNOWN), then ': ' and diagnostic text for a log. The token is what
-- a screen phrases after a restart; the text is never shown (EPIC 40, ADR 0021 —
-- that epic owns no schema number, so the reason has no column of its own).
CREATE TABLE syncState (
    id INTEGER NOT NULL PRIMARY KEY,
    ownerAccountId TEXT,
    lastOutcome TEXT,
    lastError TEXT,
    lastAttemptAtEpochMs INTEGER,
    consecutiveFailures INTEGER NOT NULL DEFAULT 0
);

selectState:
SELECT *
FROM syncState
WHERE id = 0;

ensureRow:
INSERT OR IGNORE INTO syncState(id)
VALUES (0);

setOwner:
UPDATE syncState
SET ownerAccountId = :ownerAccountId
WHERE id = 0;

recordSuccess:
UPDATE syncState
SET lastOutcome = 'SUCCESS', lastError = NULL, lastAttemptAtEpochMs = :attemptedAtEpochMs, consecutiveFailures = 0
WHERE id = 0;

recordFailure:
UPDATE syncState
SET lastOutcome = 'FAILED', lastError = :error, lastAttemptAtEpochMs = :attemptedAtEpochMs, consecutiveFailures = consecutiveFailures + 1
WHERE id = 0;

-- Forgets the last failure, e.g. on an explicit sign-out: a "session expired"
-- notice must not outlive the person choosing to leave the account.
clearFailure:
UPDATE syncState
SET lastOutcome = NULL, lastError = NULL, consecutiveFailures = 0
WHERE id = 0;

-- Rows waiting to be sent, across all six synced tables (soft-deleted ones
-- included: a tombstone is a write like any other). Observed by the change
-- push and by the Profile status line ("4 changes waiting"). A pull writes clean
-- rows, so it never raises this.
countDirtyRows:
SELECT
    (SELECT COUNT(*) FROM collectionEntry WHERE isDirty = 1) +
    (SELECT COUNT(*) FROM episodeProgress WHERE isDirty = 1) +
    (SELECT COUNT(*) FROM mediaList WHERE isDirty = 1) +
    (SELECT COUNT(*) FROM listEntry WHERE isDirty = 1) +
    (SELECT COUNT(*) FROM triageDecision WHERE isDirty = 1) +
    (SELECT COUNT(*) FROM episodePlay WHERE isDirty = 1);

-- Settings > Delete all data (EPIC 29, #72): forgets whose library this was, so
-- a later sign-in is a first sync again.
deleteRow:
DELETE FROM syncState;
