-- A title the user saved. Fields are a denormalized snapshot taken at save
-- time so the collection is fully browsable offline. Sync columns
-- (updatedAtEpochMs / isDirty / deleted) exist from day one so a change-log
-- is available before any backend is chosen.
--
-- `genres` and `runtimeMinutes` were added for EPIC 4 (profile stats): TMDB
-- genres are stored comma-joined (no genre table exists yet — the pragmatic
-- minimal path for a "genre breakdown" chart) rather than normalized;
-- `runtimeMinutes` is the movie's runtime, or a TV show's average per-episode
-- runtime when TMDB reports it, used to estimate hours watched (see
-- `feature/profile/domain`'s `ProfileStatsCalculator`, which falls back to a
-- fixed default when this is null).
--
-- `notificationsMuted` was added for EPIC 5 (new-episode notifications): a
-- per-show opt-out, independent of the global toggle in `appSettings`
-- (`SettingsRepository`/`AppSettings.notificationsEnabled`) — the Android
-- background worker excludes muted shows from its new-episode diff
-- (`NewEpisodesCalculator`, `feature/collection/domain`) before posting.
--
-- `rating` (1-10, nullable) and `note` (free text, nullable) were added for
-- EPIC 15 (ratings & notes): personal, local-only per-title data, same
-- category as `favorite` (ADR 0005 — user input, never derived) and
-- preserved across a snapshot refresh the same way (see
-- `SqlDelightCollectionRepository.upsertSnapshot`). This is the first
-- change to this table since the EPIC 10 migration baseline (ADR 0008), so
-- it ships as `2.sqm` rather than editing the `CREATE TABLE` in place.
--
-- `revisitWillingness` (nullable) and `coWatchPinned` were added for EPIC 41
-- (co-watch, ADR 0022). Both are user-authored, so they sit with favorite /
-- rating / note rather than with the snapshot, sync like them, and appear in
-- the export.
--
-- `revisitWillingness` is deliberately NULLABLE and deliberately not called a
-- rewatch flag. Null means the user has never answered for this title, which is
-- a different thing from answering "no" — an unanswered title falls back to the
-- per-device `appSettings.coWatchIncludeSeen` default, an answered one does
-- not. And `Rewatch` in this codebase is derived from `episodePlay` and never
-- stored (ADR 0012); this is stored intent about the future, so it takes its
-- own name (CONTEXT.md).
CREATE TABLE collectionEntry (
    mediaId TEXT NOT NULL PRIMARY KEY,
    mediaType TEXT NOT NULL,
    title TEXT NOT NULL,
    posterUrl TEXT,
    releaseYear INTEGER,
    productionStatus TEXT NOT NULL,
    totalEpisodes INTEGER NOT NULL DEFAULT 0,
    airedEpisodes INTEGER NOT NULL DEFAULT 0,
    favorite INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    genres TEXT NOT NULL DEFAULT '',
    runtimeMinutes INTEGER,
    addedAtEpochMs INTEGER NOT NULL,
    updatedAtEpochMs INTEGER NOT NULL,
    isDirty INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    notificationsMuted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    rating INTEGER,
    note TEXT,
    revisitWillingness INTEGER AS kotlin.Boolean,
    coWatchPinned INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

selectAll:
SELECT *
FROM collectionEntry
WHERE deleted = 0
ORDER BY addedAtEpochMs DESC;

selectById:
SELECT *
FROM collectionEntry
WHERE mediaId = :mediaId;

-- The Library's read (EPIC 28, #70): every live entry with its seen-episode
-- count in one query. It replaced one progress Flow per entry, which re-ran
-- all N queries on every tick and rebuilt all N subscriptions on every
-- snapshot refresh. The count is joined in, never stored: status is derived
-- from it by WatchStatusCalculator (ADR 0005).
selectAllWithSeen:
SELECT c.*, COALESCE(p.seenCount, 0) AS seenCount
FROM collectionEntry c
LEFT JOIN (
    SELECT mediaId, COUNT(*) AS seenCount
    FROM episodeProgress
    WHERE seen = 1
    GROUP BY mediaId
) p ON p.mediaId = c.mediaId
WHERE c.deleted = 0
ORDER BY c.addedAtEpochMs DESC;

-- One entry and its seen count, for the detail screen's membership. Deleted
-- rows are returned (the caller hides them) so the shape matches selectById.
selectByIdWithSeen:
SELECT c.*, (SELECT COUNT(*) FROM episodeProgress p WHERE p.mediaId = c.mediaId AND p.seen = 1) AS seenCount
FROM collectionEntry c
WHERE c.mediaId = :mediaId;

upsert:
INSERT OR REPLACE INTO collectionEntry(
    mediaId, mediaType, title, posterUrl, releaseYear, productionStatus,
    totalEpisodes, airedEpisodes, favorite, genres, runtimeMinutes,
    addedAtEpochMs, updatedAtEpochMs, isDirty, deleted, notificationsMuted,
    rating, note, revisitWillingness, coWatchPinned
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setFavorite:
UPDATE collectionEntry
SET favorite = :favorite, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

setNotificationsMuted:
UPDATE collectionEntry
SET notificationsMuted = :muted, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

-- [rating] is 1-10 or null to clear (validated by the domain use case, not
-- here — see `SetRatingUseCase`).
setRating:
UPDATE collectionEntry
SET rating = :rating, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

setNote:
UPDATE collectionEntry
SET note = :note, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

-- EPIC 41. Null clears the answer back to "never asked", which is why the
-- push has to send it explicitly (`explicitNulls = true`, ADR 0020).
setRevisitWillingness:
UPDATE collectionEntry
SET revisitWillingness = :willing, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

setCoWatchPinned:
UPDATE collectionEntry
SET coWatchPinned = :pinned, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

softDelete:
UPDATE collectionEntry
SET deleted = 1, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

selectDirty:
SELECT *
FROM collectionEntry
WHERE isDirty = 1;

-- Run by SyncEngine after a row has been successfully pushed (EPIC 9).
--
-- Conditional on `updatedAtEpochMs = :pushedAt` (EPIC 39): the push is an
-- awaited network call, and the user can edit the same row while it is on the
-- wire. Clearing by key alone marked that newer edit as sent, so it was never
-- pushed. Every write path bumps `updatedAtEpochMs`, so a row that changed
-- since it was read no longer matches and stays dirty for the next cycle.
clearDirty:
UPDATE collectionEntry
SET isDirty = 0
WHERE mediaId = :mediaId AND updatedAtEpochMs = :pushedAt;

-- The snapshot half of a refresh (EPIC 39, ADR 0020): what TMDB says about a
-- title, and nothing the user said. It touches neither `updatedAtEpochMs` nor
-- `isDirty` — a refresh is not an edit, so it is not synced — and it only ever
-- updates a live row: a tombstone must not be revived by a device that merely
-- looked at the title (adding a title back goes through `upsert`).
--
-- `airedEpisodes` and `totalEpisodes` are floored at the number of episodes
-- already ticked. `WatchProgress` requires `seen <= aired` and throws; ticks
-- can outrun a snapshot when another device ticked an episode this device's
-- provider data has not yet caught up to.
updateSnapshot:
UPDATE collectionEntry
SET title = :title,
    posterUrl = :posterUrl,
    releaseYear = :releaseYear,
    productionStatus = :productionStatus,
    totalEpisodes = MAX(:totalEpisodes, (SELECT COUNT(*) FROM episodeProgress WHERE episodeProgress.mediaId = collectionEntry.mediaId AND episodeProgress.seen = 1)),
    airedEpisodes = MAX(:airedEpisodes, (SELECT COUNT(*) FROM episodeProgress WHERE episodeProgress.mediaId = collectionEntry.mediaId AND episodeProgress.seen = 1)),
    genres = :genres,
    runtimeMinutes = :runtimeMinutes
WHERE mediaId = :mediaId AND deleted = 0;

-- A pulled row that wins last-write-wins against an existing local one takes
-- the *user* fields only (EPIC 39, ADR 0020): favorite, rating, note, the
-- tombstone, the add date and the stamp. The snapshot fields (title, poster,
-- episode counts...) stay as this device last fetched them — a remote copy of
-- those is only as fresh as whichever device last edited the row, and would
-- overwrite a newer snapshot. A row with no local counterpart is inserted whole
-- through `upsert`. `notificationsMuted` is per-device and never touched.
applyRemoteUserFields:
UPDATE collectionEntry
SET favorite = :favorite,
    rating = :rating,
    note = :note,
    revisitWillingness = :revisitWillingness,
    coWatchPinned = :coWatchPinned,
    deleted = :deleted,
    addedAtEpochMs = :addedAtEpochMs,
    updatedAtEpochMs = :updatedAtEpochMs,
    isDirty = 0
WHERE mediaId = :mediaId;

-- Run after a pull has applied ticks (EPIC 39). A tick pulled from another
-- device can leave more episodes seen than this device's snapshot says have
-- aired, and `WatchProgress`'s `require(seen <= aired)` throws when the Library
-- next derives that title's status. Raises the snapshot to what the ticks
-- already prove, without dirtying the row: the count is derived, not an edit.
raiseAiredToSeen:
UPDATE collectionEntry
SET airedEpisodes = (SELECT COUNT(*) FROM episodeProgress WHERE episodeProgress.mediaId = collectionEntry.mediaId AND episodeProgress.seen = 1),
    totalEpisodes = MAX(totalEpisodes, (SELECT COUNT(*) FROM episodeProgress WHERE episodeProgress.mediaId = collectionEntry.mediaId AND episodeProgress.seen = 1))
WHERE mediaId IN :mediaIds
  AND airedEpisodes < (SELECT COUNT(*) FROM episodeProgress WHERE episodeProgress.mediaId = collectionEntry.mediaId AND episodeProgress.seen = 1);

-- Every row goes back on the change-log: the first sync for an account, and
-- "resync everything" (EPIC 39, ADR 0020).
markAllDirty:
UPDATE collectionEntry SET isDirty = 1;

-- Account switch, "discard local data" (EPIC 39).
deleteAll:
DELETE FROM collectionEntry;
