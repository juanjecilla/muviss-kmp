-- A title the user saved. Fields are a denormalized snapshot taken at save
-- time so the collection is fully browsable offline. Sync columns
-- (updatedAtEpochMs / isDirty / deleted) exist from day one so a change-log
-- is available before any backend is chosen.
CREATE TABLE collectionEntry (
    mediaId TEXT NOT NULL PRIMARY KEY,
    mediaType TEXT NOT NULL,
    title TEXT NOT NULL,
    posterUrl TEXT,
    releaseYear INTEGER,
    productionStatus TEXT NOT NULL,
    totalEpisodes INTEGER NOT NULL DEFAULT 0,
    airedEpisodes INTEGER NOT NULL DEFAULT 0,
    favorite INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    addedAtEpochMs INTEGER NOT NULL,
    updatedAtEpochMs INTEGER NOT NULL,
    isDirty INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

selectAll:
SELECT *
FROM collectionEntry
WHERE deleted = 0
ORDER BY addedAtEpochMs DESC;

selectById:
SELECT *
FROM collectionEntry
WHERE mediaId = :mediaId;

upsert:
INSERT OR REPLACE INTO collectionEntry(
    mediaId, mediaType, title, posterUrl, releaseYear, productionStatus,
    totalEpisodes, airedEpisodes, favorite, addedAtEpochMs, updatedAtEpochMs,
    isDirty, deleted
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setFavorite:
UPDATE collectionEntry
SET favorite = :favorite, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

softDelete:
UPDATE collectionEntry
SET deleted = 1, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

selectDirty:
SELECT *
FROM collectionEntry
WHERE isDirty = 1;
