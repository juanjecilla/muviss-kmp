-- EPIC 41 (co-watch, ADR 0022, #118). The filename is the version this migrates
-- FROM, not to: 11.sqm takes a v11 database to v12.
--
-- NUMBERING: EPIC 28 (#70) claimed `11.sqm` first and has not merged. The chain
-- has to stay contiguous and `10.sqm` (EPIC 26) is the last file present, so
-- this takes 11 and whichever of the two merges second renumbers to 12 and
-- regenerates its fixture. `verifyMigrations` cannot see that collision —
-- each branch is self-consistent and green alone, and the clash only appears at
-- merge — so this note is the warning, per `docs/EPICS.md`.
--
-- Nothing is backfilled and nothing can be. A NULL `revisitWillingness` is
-- meaningful: it says the user has never answered for that title, which is
-- different from answering "no", and it falls back to the per-device
-- `coWatchIncludeSeen` default. Defaulting existing rows to 0 would silently
-- answer "no" on behalf of every title in every library.
--
-- The two new columns on `collectionEntry` are user-authored and sync; the two
-- on `appSettings` are per-device and do not. Appended in both cases, where
-- `verifyMigrations` expects an `ALTER TABLE ADD COLUMN` to have put them.

ALTER TABLE collectionEntry ADD COLUMN revisitWillingness INTEGER;
ALTER TABLE collectionEntry ADD COLUMN coWatchPinned INTEGER NOT NULL DEFAULT 0;

ALTER TABLE appSettings ADD COLUMN coWatchPoolListId TEXT;
ALTER TABLE appSettings ADD COLUMN coWatchIncludeSeen INTEGER NOT NULL DEFAULT 1;

-- A link is two rows, one per side; `state` is ours and syncs, `remoteState` is
-- theirs and is cache. `localName` never leaves this device.
CREATE TABLE companionLink (
    companionUserId TEXT NOT NULL PRIMARY KEY,
    localName TEXT,
    nonce TEXT NOT NULL,
    state TEXT NOT NULL,
    remoteState TEXT,
    createdAtEpochMs INTEGER NOT NULL,
    updatedAtEpochMs INTEGER NOT NULL,
    isDirty INTEGER NOT NULL DEFAULT 1,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- What we publish. User data: change-log columns, soft deletes (ADR 0013).
CREATE TABLE companionPoolOut (
    companionUserId TEXT NOT NULL,
    mediaId TEXT NOT NULL,
    mediaType TEXT NOT NULL,
    title TEXT NOT NULL,
    posterUrl TEXT,
    genres TEXT NOT NULL DEFAULT '',
    runtimeMinutes INTEGER,
    started INTEGER NOT NULL DEFAULT 0,
    seen INTEGER NOT NULL DEFAULT 0,
    pinned INTEGER NOT NULL DEFAULT 0,
    updatedAtEpochMs INTEGER NOT NULL,
    isDirty INTEGER NOT NULL DEFAULT 1,
    deleted INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (companionUserId, mediaId)
);

-- What they published. Cache, like the episode catalog (ADR 0015): no dirty
-- flag, no tombstone, a pull always wins, and it is absent from the export.
CREATE TABLE companionPoolIn (
    companionUserId TEXT NOT NULL,
    mediaId TEXT NOT NULL,
    mediaType TEXT NOT NULL,
    title TEXT NOT NULL,
    posterUrl TEXT,
    genres TEXT NOT NULL DEFAULT '',
    runtimeMinutes INTEGER,
    started INTEGER NOT NULL DEFAULT 0,
    seen INTEGER NOT NULL DEFAULT 0,
    pinned INTEGER NOT NULL DEFAULT 0,
    publishedAtEpochMs INTEGER NOT NULL,
    PRIMARY KEY (companionUserId, mediaId)
);

CREATE INDEX companionPoolIn_companion ON companionPoolIn(companionUserId);
