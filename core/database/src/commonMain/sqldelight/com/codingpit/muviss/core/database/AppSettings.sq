-- Single-row app settings: theme, TMDB language/region, and the global
-- notifications toggle (EPIC 8). Always exactly one row (id = 0); the
-- repository calls `ensureRow` before it ever reads so `selectSettings`
-- never has to model "no row yet" beyond first launch.
--
-- `lastSyncedAtEpochMs` was added in `3.sqm` (EPIC 9, sync): null means
-- "never synced"; `SyncEngine` stamps it after a completed push+pull cycle.
--
-- `triageControlScheme` and `triageTutorialSeen` were added in `4.sqm`
-- (triage, ADR 0010). Both are per-device UI preferences, deliberately NOT
-- synced — same category as `collectionEntry.notificationsMuted`. Columns
-- added by a migration must stay LAST in this declaration: `ALTER TABLE ADD
-- COLUMN` appends, and `verifyMigrations` compares ordinal position.
--
-- `animationsEnabled` and `triageDeckAnimations` were added in `5.sqm`. The
-- first is the app-wide motion switch; the second turns off the triage deck's
-- own card animations on their own. The effective value is the AND of the two,
-- so the master switch turns everything off and the per-feature switch narrows
-- it further. Both are per-device UI preferences and, like the two above, are
-- deliberately NOT synced: motion tolerance belongs to a device and the person
-- holding it, not to a library.
--
-- `syncCursorEpochMs` was added in `7.sqm`. It is NOT a second copy of
-- `lastSyncedAtEpochMs`: that one answers "when did this device last complete
-- a cycle" and is stamped from the local clock for the profile screen's label,
-- while this one is the high-water mark of `updatedAtEpochMs` values the
-- *server* returned, and is what the next pull filters on. They were one
-- column until sharing them turned out to drop rows — a device whose clock
-- runs ahead stamps rows above the reading device's "now", and a cursor taken
-- from the reader's clock skips them forever. Null means "never pulled", which
-- asks for a full pull; that is why `7.sqm` does not backfill it from
-- `lastSyncedAtEpochMs`, whose value is exactly the untrusted clock reading.
--
-- **`syncCursorEpochMs` is dead as of `9.sqm`** (EPIC 39, ADR 0020): a maximum of
-- client clocks is the wrong thing to page a change feed by, so the cursor is
-- now a server-assigned sequence, one per table, in `syncCursor`. The column is
-- left in place because dropping it would need a table rebuild for nothing.
--
-- `syncAutomatically` was added in `9.sqm` (EPIC 39 claimed the number for the
-- whole sync-correctness schema; EPIC 40 is what reads it). It is the per-device
-- "sync in the background" switch, default off, and like the preferences above
-- it is deliberately NOT synced. Read by `FeatureFlags.syncAutomatically` (EPIC 40).
--
-- `crashReportsEnabled` was added in `10.sqm` (EPIC 26). Default on; it is the
-- "Send crash reports" switch, per-device and not synced. Unlike its neighbours
-- it is also read *before* Koin exists — `CrashReportsConsent` opens the
-- database on its own short-lived driver so Sentry can start ahead of the
-- graph — which is why the column name is referenced from `:core:database`.
CREATE TABLE appSettings (
    id INTEGER NOT NULL PRIMARY KEY,
    theme TEXT NOT NULL DEFAULT 'SYSTEM',
    language TEXT NOT NULL DEFAULT 'en-US',
    region TEXT NOT NULL DEFAULT 'US',
    notificationsEnabled INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    lastSyncedAtEpochMs INTEGER,
    triageControlScheme TEXT NOT NULL DEFAULT 'FOUR_WAY',
    triageTutorialSeen INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    animationsEnabled INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    triageDeckAnimations INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    syncCursorEpochMs INTEGER,
    syncAutomatically INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    crashReportsEnabled INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

selectSettings:
SELECT *
FROM appSettings
WHERE id = 0;

ensureRow:
INSERT OR IGNORE INTO appSettings(id, theme, language, region, notificationsEnabled)
VALUES (0, 'SYSTEM', 'en-US', 'US', 1);

updateTheme:
UPDATE appSettings SET theme = :theme WHERE id = 0;

updateLanguage:
UPDATE appSettings SET language = :language WHERE id = 0;

updateRegion:
UPDATE appSettings SET region = :region WHERE id = 0;

updateNotificationsEnabled:
UPDATE appSettings SET notificationsEnabled = :notificationsEnabled WHERE id = 0;

updateLastSyncedAt:
UPDATE appSettings SET lastSyncedAtEpochMs = :lastSyncedAtEpochMs WHERE id = 0;

updateSyncCursor:
UPDATE appSettings SET syncCursorEpochMs = :syncCursorEpochMs WHERE id = 0;

updateTriageControlScheme:
UPDATE appSettings SET triageControlScheme = :triageControlScheme WHERE id = 0;

updateTriageTutorialSeen:
UPDATE appSettings SET triageTutorialSeen = :triageTutorialSeen WHERE id = 0;

updateAnimationsEnabled:
UPDATE appSettings SET animationsEnabled = :animationsEnabled WHERE id = 0;

updateTriageDeckAnimations:
UPDATE appSettings SET triageDeckAnimations = :triageDeckAnimations WHERE id = 0;

updateCrashReportsEnabled:
UPDATE appSettings SET crashReportsEnabled = :crashReportsEnabled WHERE id = 0;

updateSyncAutomatically:
UPDATE appSettings SET syncAutomatically = :syncAutomatically WHERE id = 0;
