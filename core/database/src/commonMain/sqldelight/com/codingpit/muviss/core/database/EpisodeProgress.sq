-- Per-episode watched ticks: the single source of truth from which watch
-- status is derived. Also carries sync columns for the future change-log.
CREATE TABLE episodeProgress (
    episodeId TEXT NOT NULL PRIMARY KEY,
    mediaId TEXT NOT NULL,
    seasonNumber INTEGER NOT NULL,
    episodeNumber INTEGER NOT NULL,
    seen INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    updatedAtEpochMs INTEGER NOT NULL,
    isDirty INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

CREATE INDEX episodeProgress_mediaId ON episodeProgress(mediaId);
-- Sync's selectDirty reads only these (EPIC 28, 15.sqm).
CREATE INDEX episodeProgress_dirty ON episodeProgress(isDirty) WHERE isDirty = 1;

selectForMedia:
SELECT *
FROM episodeProgress
WHERE mediaId = :mediaId;

-- Single-row lookup by natural key — used by `SyncEngine` (EPIC 9) to read
-- the current local value before deciding whether a pulled remote row wins
-- the last-write-wins comparison.
selectByEpisodeId:
SELECT *
FROM episodeProgress
WHERE episodeId = :episodeId;

-- Every row, unfiltered — used by settings' data export (EPIC 8), which
-- dumps the whole table rather than one title's slice.
selectAll:
SELECT *
FROM episodeProgress;

countSeenForMedia:
SELECT COUNT(*)
FROM episodeProgress
WHERE mediaId = :mediaId AND seen = 1;

-- Every currently-seen row's tick timestamp, across all media — the raw
-- material for the profile feature's watch-streak calculation (see
-- `feature/profile/domain`'s `WatchStreakCalculator`). Un-ticking an episode
-- removes it from this result, so a streak day is only as durable as the
-- ticks behind it; there is no separate history log (see ADR 0005).
selectSeenUpdatedAt:
SELECT updatedAtEpochMs
FROM episodeProgress
WHERE seen = 1;

upsert:
INSERT OR REPLACE INTO episodeProgress(
    episodeId, mediaId, seasonNumber, episodeNumber, seen, updatedAtEpochMs, isDirty
)
VALUES (?, ?, ?, ?, ?, ?, ?);

setSeen:
UPDATE episodeProgress
SET seen = :seen, updatedAtEpochMs = :now, isDirty = 1
WHERE episodeId = :episodeId;

-- Un-ticks every episode of one title in a single statement. Added for
-- triage's undo (ADR 0010): taking back a "caught up" verdict has to take
-- back the ticks it wrote, or the title would sit in the library still
-- reading as fully watched. Un-ticks rather than deletes, matching this
-- table's no-soft-delete convention (see below) — `seen = 0` is itself the
-- state change sync replays.
clearForMedia:
UPDATE episodeProgress
SET seen = 0, updatedAtEpochMs = :now, isDirty = 1
WHERE mediaId = :mediaId;

-- EPIC 9 (sync): episode ticks are idempotent booleans with no soft-delete
-- (un-ticking just sets seen = 0, that state change is itself what
-- propagates — see ADR 0009), so there is no tombstone to worry about here,
-- only a plain dirty change-log.
selectDirty:
SELECT *
FROM episodeProgress
WHERE isDirty = 1;

-- Run by SyncEngine after a row has been successfully pushed. Conditional on
-- the stamp the push carried, so an edit made while it was in flight stays dirty
-- (see `collectionEntry`'s `clearDirty`).
clearDirty:
UPDATE episodeProgress
SET isDirty = 0
WHERE episodeId = :episodeId AND updatedAtEpochMs = :pushedAt;

-- First sync for an account, and "resync everything" (EPIC 39, ADR 0020).
markAllDirty:
UPDATE episodeProgress SET isDirty = 1;

-- Account switch, "discard local data" (EPIC 39).
deleteAll:
DELETE FROM episodeProgress;
