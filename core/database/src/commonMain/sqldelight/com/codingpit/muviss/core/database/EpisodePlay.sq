-- Rewatch history: one row per viewing, with the day it happened.
--
-- ADR 0005 originally said progress carries no separate history log, and for
-- a long time it didn't need one: an episode was seen or it wasn't. Watching
-- something a second time had nowhere to go — re-tapping a ticked episode
-- just un-ticked it. ADR 0011 records the reversal and why a counter column
-- was not enough: a count answers "how many times" and nothing else, so
-- "how often did I rewatch this year" would have been permanently
-- unanswerable. Rows carry their timestamp for exactly that reason.
--
-- `episodeProgress.seen` deliberately stays where it is rather than becoming
-- a view over this table: the sync change-log, `clearForMedia` and
-- last-write-wins all key off it, and un-ticking propagates as `seen = 0`
-- (ADR 0009). Both are written together through the repository. `playCount`
-- is derived here and never stored.
--
-- Movies use `EpisodeId.forMovie`'s single synthetic id, same as
-- `episodeProgress`, so rewatching a film is recorded identically.
--
-- `isDirty` is present from the start so the change-log shape is right, but
-- nothing pushes these rows yet: v1 is local-only, and append-only rows need
-- a different conflict rule than ADR 0009's last-write-wins. See ADR 0011.
CREATE TABLE episodePlay (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    episodeId TEXT NOT NULL,
    mediaId TEXT NOT NULL,
    watchedAtEpochMs INTEGER NOT NULL,
    isDirty INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

CREATE INDEX episodePlay_episodeId ON episodePlay(episodeId);
CREATE INDEX episodePlay_mediaId ON episodePlay(mediaId);

insert:
INSERT INTO episodePlay(episodeId, mediaId, watchedAtEpochMs, isDirty)
VALUES (?, ?, ?, ?);

-- "I ticked that by mistake": drops the newest viewing only, so an episode
-- genuinely watched three times goes to two rather than losing its history.
deleteLatestForEpisode:
DELETE FROM episodePlay
WHERE id = (
    SELECT id FROM episodePlay
    WHERE episodeId = :episodeId
    ORDER BY watchedAtEpochMs DESC, id DESC
    LIMIT 1
);

-- The destructive one, reachable only from episode detail's explicit
-- "clear watch history".
deleteAllForEpisode:
DELETE FROM episodePlay
WHERE episodeId = :episodeId;

deleteAllForMedia:
DELETE FROM episodePlay
WHERE mediaId = :mediaId;

countForEpisode:
SELECT COUNT(*)
FROM episodePlay
WHERE episodeId = :episodeId;

-- Play counts for one title in a single round trip, for the detail screen's
-- per-episode "watched 3x" markers.
countsForMedia:
SELECT episodeId, COUNT(*) AS playCount
FROM episodePlay
WHERE mediaId = :mediaId
GROUP BY episodeId;

selectForEpisode:
SELECT *
FROM episodePlay
WHERE episodeId = :episodeId
ORDER BY watchedAtEpochMs DESC, id DESC;

-- Every viewing's timestamp, across all titles — the profile watch-streak's
-- input. Unlike the `episodeProgress.updatedAtEpochMs` it replaces, a rewatch
-- adds a day here instead of moving an old one.
selectAllWatchedAt:
SELECT watchedAtEpochMs
FROM episodePlay;

-- Rewatches per title, for the profile's "most rewatched" ranking.
--
-- A *rewatch* is a play that has an earlier play of the same episode — at any
-- date, not merely inside the window. That is the entire reason for the CTE:
-- over all time this result is exactly `COUNT(*) - COUNT(DISTINCT episodeId)`
-- and a plain GROUP BY would do, but under a window a plain GROUP BY answers
-- a different, wrong question. An episode first seen in December and watched
-- again in March is a rewatch *in March*; recomputing "first play" inside the
-- window would read that March viewing as a first watch and report nothing.
-- See ADR 0012.
--
-- The bare `id` beside `MIN(watchedAtEpochMs)` is SQLite's documented
-- min-row rule: in a MIN/MAX aggregate query the unaggregated columns come
-- from the row that produced the extreme. It disambiguates two viewings
-- recorded in the same millisecond, so neither is silently dropped.
--
-- `:since` bounds the *rewatch* play only, never the first one. Pass 0 for
-- all time.
rewatchCountsByMedia:
WITH firstPlay AS (
    SELECT episodeId, MIN(watchedAtEpochMs) AS firstAt, id AS firstId
    FROM episodePlay
    GROUP BY episodeId
)
SELECT p.mediaId, COUNT(*) AS rewatches
FROM episodePlay p
JOIN firstPlay f ON p.episodeId = f.episodeId
WHERE (p.watchedAtEpochMs > f.firstAt OR (p.watchedAtEpochMs = f.firstAt AND p.id > f.firstId))
  AND p.watchedAtEpochMs >= :since
GROUP BY p.mediaId;

-- Every rewatch's timestamp since :since, across all titles — the input to the
-- profile's rewatch trend. Months are bucketed in Kotlin (`CivilDate`) rather
-- than by SQLite's date functions, so the chart shares the UTC epoch-day
-- convention `WatchStreak` already uses instead of inventing a second one.
--
-- Unlike the ranking, this deliberately does not care whether the title is
-- still in the library: a play is an event that happened, and removing a
-- title does not un-happen it (ADR 0012).
rewatchTimestamps:
WITH firstPlay AS (
    SELECT episodeId, MIN(watchedAtEpochMs) AS firstAt, id AS firstId
    FROM episodePlay
    GROUP BY episodeId
)
SELECT p.watchedAtEpochMs
FROM episodePlay p
JOIN firstPlay f ON p.episodeId = f.episodeId
WHERE (p.watchedAtEpochMs > f.firstAt OR (p.watchedAtEpochMs = f.firstAt AND p.id > f.firstId))
  AND p.watchedAtEpochMs >= :since;

-- Whole table, for settings' data export (EPIC 8).
selectAll:
SELECT *
FROM episodePlay;

selectDirty:
SELECT *
FROM episodePlay
WHERE isDirty = 1;

clearDirty:
UPDATE episodePlay
SET isDirty = 0
WHERE id = :id;
