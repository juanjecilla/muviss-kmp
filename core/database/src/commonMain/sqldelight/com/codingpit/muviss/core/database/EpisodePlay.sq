-- Rewatch history: one row per viewing, with the day it happened.
--
-- ADR 0005 originally said progress carries no separate history log, and for
-- a long time it didn't need one: an episode was seen or it wasn't. Watching
-- something a second time had nowhere to go — re-tapping a ticked episode
-- just un-ticked it. ADR 0011 records the reversal and why a counter column
-- was not enough: a count answers "how many times" and nothing else, so
-- "how often did I rewatch this year" would have been permanently
-- unanswerable. Rows carry their timestamp for exactly that reason.
--
-- `episodeProgress.seen` deliberately stays where it is rather than becoming
-- a view over this table: the sync change-log, `clearForMedia` and
-- last-write-wins all key off it, and un-ticking propagates as `seen = 0`
-- (ADR 0009). Both are written together through the repository. `playCount`
-- is derived here and never stored.
--
-- Movies use `EpisodeId.forMovie`'s single synthetic id, same as
-- `episodeProgress`, so rewatching a film is recorded identically.
--
-- ADR 0013 reversed this table's original "v1 is local-only" stance and put it
-- on the change-log. Two shape changes were needed and both landed in `7.sqm`:
--
--   * `id` went from `INTEGER AUTOINCREMENT` to a deterministic TEXT key,
--     `episodeId || '@' || watchedAtEpochMs`. A surrogate autoincrement is
--     per-device — device A's play #5 and device B's play #5 are different
--     viewings — so it could never be a sync key. Deriving identity from the
--     viewing itself makes the same viewing the same row everywhere, which is
--     what lets ADR 0009's last-write-wins apply here unchanged. It also makes
--     a double push idempotent instead of duplicating history.
--
--   * The three hard `DELETE`s became soft deletes. Last-write-wins cannot
--     express a hard delete: a removed row has nothing left to carry a
--     timestamp, so the other device's older copy would simply be pushed back.
--     Every read below therefore filters `deleted = 0`; forgetting that filter
--     silently inflates a play count or the profile watch-streak.
--
-- The accepted cost is that two viewings of one episode recorded in the same
-- millisecond collapse into a single row. That is not reachable by tapping.
CREATE TABLE episodePlay (
    id TEXT NOT NULL PRIMARY KEY,
    episodeId TEXT NOT NULL,
    mediaId TEXT NOT NULL,
    watchedAtEpochMs INTEGER NOT NULL,
    updatedAtEpochMs INTEGER NOT NULL,
    isDirty INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    deleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE INDEX episodePlay_episodeId ON episodePlay(episodeId);
CREATE INDEX episodePlay_mediaId ON episodePlay(mediaId);

-- The only way a row is written, locally or from a pulled remote change.
--
-- OR REPLACE, not a plain INSERT: with a deterministic id two ticks inside one
-- millisecond now collide on the primary key where they used to produce two
-- rows. Replacing also revives an id that was soft-deleted earlier, which is
-- the right outcome — the user is recording that viewing again.
--
-- `id` is passed in rather than composed here (`episodeId || '@' ||
-- watchedAtEpochMs` would bind one parameter as both TEXT and INTEGER, which
-- SQLDelight cannot type). `SqlDelightProgressRepository.playId` is where a
-- local row's id comes from; a remote one arrives already carrying it.
upsert:
INSERT OR REPLACE INTO episodePlay(id, episodeId, mediaId, watchedAtEpochMs, updatedAtEpochMs, isDirty, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT *
FROM episodePlay
WHERE id = :id;

-- "I ticked that by mistake": drops the newest viewing only, so an episode
-- genuinely watched three times goes to two rather than losing its history.
deleteLatestForEpisode:
UPDATE episodePlay
SET deleted = 1, isDirty = 1, updatedAtEpochMs = :updatedAtEpochMs
WHERE id = (
    SELECT id FROM episodePlay
    WHERE episodeId = :episodeId AND deleted = 0
    ORDER BY watchedAtEpochMs DESC, id DESC
    LIMIT 1
);

-- The destructive one, reachable only from episode detail's explicit
-- "clear watch history".
deleteAllForEpisode:
UPDATE episodePlay
SET deleted = 1, isDirty = 1, updatedAtEpochMs = :updatedAtEpochMs
WHERE episodeId = :episodeId AND deleted = 0;

deleteAllForMedia:
UPDATE episodePlay
SET deleted = 1, isDirty = 1, updatedAtEpochMs = :updatedAtEpochMs
WHERE mediaId = :mediaId AND deleted = 0;

countForEpisode:
SELECT COUNT(*)
FROM episodePlay
WHERE episodeId = :episodeId AND deleted = 0;

-- Play counts for one title in a single round trip, for the detail screen's
-- per-episode "watched 3x" markers.
countsForMedia:
SELECT episodeId, COUNT(*) AS playCount
FROM episodePlay
WHERE mediaId = :mediaId AND deleted = 0
GROUP BY episodeId;

selectForEpisode:
SELECT *
FROM episodePlay
WHERE episodeId = :episodeId AND deleted = 0
ORDER BY watchedAtEpochMs DESC, id DESC;

-- Every viewing's timestamp, across all titles — the profile watch-streak's
-- input. Unlike the `episodeProgress.updatedAtEpochMs` it replaces, a rewatch
-- adds a day here instead of moving an old one.
selectAllWatchedAt:
SELECT watchedAtEpochMs
FROM episodePlay
WHERE deleted = 0;

-- Both rewatch queries filter `deleted = 0` in the CTE *and* in the outer
-- query, and both halves matter. Outer only would still let a deleted first
-- viewing anchor `firstAt`, so a surviving later play would stop counting as a
-- rewatch; CTE only would count deleted plays as rewatches. These arrived from
-- EPIC 21 while this branch was making play deletes soft (ADR 0013) — git
-- merged both sides cleanly and produced stats that counted rows the user had
-- cleared, which is the failure mode this table's header warns about.
--
-- Rewatches per title, for the profile's "most rewatched" ranking.
--
-- A *rewatch* is a play that has an earlier play of the same episode — at any
-- date, not merely inside the window. That is the entire reason for the CTE:
-- over all time this result is exactly `COUNT(*) - COUNT(DISTINCT episodeId)`
-- and a plain GROUP BY would do, but under a window a plain GROUP BY answers
-- a different, wrong question. An episode first seen in December and watched
-- again in March is a rewatch *in March*; recomputing "first play" inside the
-- window would read that March viewing as a first watch and report nothing.
-- See ADR 0012.
--
-- The bare `id` beside `MIN(watchedAtEpochMs)` is SQLite's documented
-- min-row rule: in a MIN/MAX aggregate query the unaggregated columns come
-- from the row that produced the extreme. It disambiguates two viewings
-- recorded in the same millisecond, so neither is silently dropped.
--
-- `:since` bounds the *rewatch* play only, never the first one. Pass 0 for
-- all time.
rewatchCountsByMedia:
WITH firstPlay AS (
    SELECT episodeId, MIN(watchedAtEpochMs) AS firstAt, id AS firstId
    FROM episodePlay
    WHERE deleted = 0
    GROUP BY episodeId
)
SELECT p.mediaId, COUNT(*) AS rewatches
FROM episodePlay p
JOIN firstPlay f ON p.episodeId = f.episodeId
WHERE (p.watchedAtEpochMs > f.firstAt OR (p.watchedAtEpochMs = f.firstAt AND p.id > f.firstId))
  AND p.watchedAtEpochMs >= :since
  AND p.deleted = 0
GROUP BY p.mediaId;

-- Every rewatch's timestamp since :since, across all titles — the input to the
-- profile's rewatch trend. Months are bucketed in Kotlin (`CivilDate`) rather
-- than by SQLite's date functions, so the chart shares the UTC epoch-day
-- convention `WatchStreak` already uses instead of inventing a second one.
--
-- Unlike the ranking, this deliberately does not care whether the title is
-- still in the library: a play is an event that happened, and removing a
-- title does not un-happen it (ADR 0012).
rewatchTimestamps:
WITH firstPlay AS (
    SELECT episodeId, MIN(watchedAtEpochMs) AS firstAt, id AS firstId
    FROM episodePlay
    WHERE deleted = 0
    GROUP BY episodeId
)
SELECT p.watchedAtEpochMs
FROM episodePlay p
JOIN firstPlay f ON p.episodeId = f.episodeId
WHERE (p.watchedAtEpochMs > f.firstAt OR (p.watchedAtEpochMs = f.firstAt AND p.id > f.firstId))
  AND p.watchedAtEpochMs >= :since
  AND p.deleted = 0;

-- Whole table, for settings' data export (EPIC 8).
selectAll:
SELECT *
FROM episodePlay
WHERE deleted = 0;

selectDirty:
SELECT *
FROM episodePlay
WHERE isDirty = 1;

-- Conditional on the stamp the push carried; see `collectionEntry`'s `clearDirty`.
clearDirty:
UPDATE episodePlay
SET isDirty = 0
WHERE id = :id AND updatedAtEpochMs = :pushedAt;

-- First sync for an account, and "resync everything" (EPIC 39, ADR 0020). This
-- is also what lets rewatch history that predates `7.sqm` reach the server: those
-- plays were derived from ticks that had long since been pushed, so they were
-- clean and nothing would ever have sent them.
markAllDirty:
UPDATE episodePlay SET isDirty = 1;

-- Account switch, "discard local data" (EPIC 39).
deleteAll:
DELETE FROM episodePlay;

-- Post-pull reconciliation of `seen` against the play rows (EPIC 39, ADR 0020).
-- `episodeProgress.seen` and `episodePlay` are written together locally and
-- merged independently by sync, so two devices can leave them disagreeing.
-- These two queries put them back in step for the titles a pull touched.
--
-- A tick with no live viewing gets one, at the tick's own timestamp. The id is
-- the derived `episodeId@watchedAtEpochMs` (ADR 0013), so two devices that each
-- repair the same tick write the same row rather than two. It is dirty: the
-- server may not have it either.
insertMissingPlaysForSeen:
INSERT OR REPLACE INTO episodePlay(id, episodeId, mediaId, watchedAtEpochMs, updatedAtEpochMs, isDirty, deleted)
SELECT p.episodeId || '@' || p.updatedAtEpochMs, p.episodeId, p.mediaId, p.updatedAtEpochMs, p.updatedAtEpochMs, 1, 0
FROM episodeProgress p
WHERE p.mediaId IN :mediaIds
  AND p.seen = 1
  AND NOT EXISTS (SELECT 1 FROM episodePlay e WHERE e.episodeId = p.episodeId AND e.deleted = 0);

-- An un-tick wins: the viewings of an episode that ended up not seen are
-- tombstoned. Otherwise `recordPlaysForUnseen` sees a live play, skips the
-- episode, and the title can never reach Watched. The tombstone's stamp is the
-- newer of the play's and the un-tick's, so it wins last-write-wins on the
-- server and every device computes the same one.
tombstonePlaysForUnseen:
UPDATE episodePlay
SET deleted = 1,
    isDirty = 1,
    updatedAtEpochMs = MAX(updatedAtEpochMs, (SELECT p.updatedAtEpochMs FROM episodeProgress p WHERE p.episodeId = episodePlay.episodeId))
WHERE deleted = 0
  AND mediaId IN :mediaIds
  AND EXISTS (SELECT 1 FROM episodeProgress p WHERE p.episodeId = episodePlay.episodeId AND p.seen = 0);

-- Near-duplicate merge (#87/#97, ADR 0013's amendment): two devices that each
-- tick the same episode while unsynced write two live plays a few
-- milliseconds apart (the id is the derived `episodeId@watchedAtEpochMs`, so
-- the millisecond difference is enough to keep both rows). `rewatchCountsByMedia`
-- would otherwise count the second arrival as a rewatch.
--
-- Ordered rather than aggregated: `RemoteApplier.mergeDuplicatePlays` walks
-- this per episode and decides, in Kotlin, which live plays fall inside 5
-- minutes of the earliest one in their cluster and tombstones those — see its
-- KDoc for why that step is not plain SQL (no window functions on Android's
-- bundled SQLite, per ADR 0012's "No window functions" consequence).
selectLiveForMediaIds:
SELECT *
FROM episodePlay
WHERE mediaId IN :mediaIds AND deleted = 0
ORDER BY episodeId, watchedAtEpochMs, id;

-- One row's half of `RemoteApplier.mergeDuplicatePlays`: soft-deletes a play
-- decided to be a near-duplicate of another, already-kept one. `updatedAtEpochMs`
-- is the merge's own timestamp rather than a MAX(...) against anything else —
-- two devices that each run this merge sort the same live rows the same way
-- (ties broken by `id`) and so tombstone the same id independently, so which
-- stamp wins last-write-wins does not matter: the surviving content
-- (`deleted = 1`) is identical either way.
tombstoneDuplicatePlay:
UPDATE episodePlay
SET deleted = 1, isDirty = 1, updatedAtEpochMs = :updatedAtEpochMs
WHERE id = :id AND deleted = 0;
