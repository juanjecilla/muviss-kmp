<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AndroidConnectivityMonitor reads the default network. The app declares this too; the
         library declares it so its own lint can see the permission its calls need (#688). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
