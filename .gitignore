# Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!src/**/build/

# Local config / secrets
local.properties
*.local

# Release signing (never commit a keystore, see docs/RELEASING.md)
*.jks
*.keystore

# IDE
.idea/
*.iml
*.ipr
*.iws
.fleet/
.vscode/

# macOS
.DS_Store

# Kotlin
.kotlin/

# Xcode / iOS
xcuserdata/
*.xcuserstate
app/iosApp/iosApp.xcodeproj/project.xcworkspace/xcuserdata/
app/iosApp/iosApp.xcodeproj/xcuserdata/
Pods/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Logs
*.log

# Web
node_modules/
# kotlin-js-store/ is tracked on purpose: its two yarn.lock files pin every npm
# package the JS and Wasm builds resolve, and Kotlin's yarn-lock check fails the
# build when a dependency change is not reflected in them (#67). Refresh with
# ./gradlew kotlinUpgradeYarnLock kotlinWasmUpgradeYarnLock.

# Heap dumps from a Gradle/Kotlin OOM (#49) and Android Studio captures
*.hprof
captures/

# Supabase CLI: local state and the linked project ref (supabase/.temp),
# never the migrations — those are the schema's source of truth (docs/SYNC.md).
supabase/.temp/
supabase/.branches/

# Agent worktrees: `.claude/worktrees/<name>` is a complete second checkout of
# the module tree, so `git add -A` from the repo root would otherwise stage
# thousands of files from inside one. `git commit -a` would not — it skips
# untracked files — which is why this went unnoticed (issue #48).
#
# Deliberately narrow. The rest of `.claude/` stays trackable so project-level
# agent config (settings.json, skills) can be committed if we ever choose to:
# ignoring the whole directory would make that a git footgun, since git does
# not descend into an excluded directory and a bare `!.claude/settings.json`
# under `.claude/` simply does not work.
.claude/worktrees/

# fastlane (ADR 0024)
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
# Generated from fastlane/release-notes/<tag>/ by the Fastfile.
fastlane/metadata/android/*/changelogs/
vendor/bundle/
.bundle/

# Local secrets. Never committed; the dev Supabase credentials live in the
# supabase-dev GitHub environment and the owner's Keychain.
.env
.env.*
