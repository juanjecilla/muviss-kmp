<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker preview on API 31+ (previewLayout). It mirrors
     drawable/widget_preview.xml, the previewImage older launchers show, so the
     two stay in step: sizes are dp on a 4x2 cell card. RemoteViews-safe views
     only (FrameLayout, LinearLayout, TextView, ImageView). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="88dp"
        android:layout_gravity="center_vertical|start"
        android:background="@drawable/widget_preview_poster" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="78dp"
        android:layout_marginEnd="46dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_kicker"
            android:textColor="#FFFFCB6B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_preview_title"
            android:textColor="#FFE9E2D4"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_preview_episode"
            android:textColor="#FFCFC6B4"
            android:textSize="12sp"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_preview_track"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="56"
                android:background="@drawable/widget_preview_fill" />

            <FrameLayout
                android:id="@+id/widget_preview_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="30" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical|end"
        android:background="@drawable/widget_preview_tick">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_preview_check"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>
