<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only network use: TMDB metadata lookups and optional Sentry crash
         reports. Declared explicitly instead of relying on it arriving via
         manifest merge from a dependency (e.g. Ktor/Coil/Sentry). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- EPIC 5 (new-episode notifications): runtime-requested on API 33+ from
         MainActivity on first app open (see its doc comment); a no-op
         declaration on older APIs where the permission doesn't exist. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false: Muviss is local-first and the collection/progress
         SQLite DB is the source of truth (see ADR 0002/0005). Android's
         auto-backup only captures app files opportunistically and can
         restore a stale/partial DB snapshot onto a new device, silently
         diverging from what the user actually watched. Until Muviss ships
         its own export/import (see EPIC 8) or cloud sync (EPIC 9), backup
         is off rather than half-working. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".MuvissApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Muviss">
        <activity
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth sign-in comes back here (ADR 0014). The scheme/host
                 must stay identical to `OAUTH_REDIRECT_URI` in
                 :core:sync's OAuthRedirect.kt and to
                 `additional_redirect_urls` in supabase/config.toml — XML
                 cannot reference the Kotlin constant, so all three move
                 together. singleTask (above) is what makes the redirect
                 reach the running app through onNewIntent rather than
                 starting a second instance on top of it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="muviss" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- "Watch next" home-screen widget (EPIC 22). Runs in this process,
             so it resolves ProgressApi from the Koin graph MuvissApplication
             started — the same route NewEpisodesWorker takes. -->
        <receiver
            android:exported="false"
            android:name=".widget.MuvissWidgetReceiver">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/muviss_widget_info" />
        </receiver>
    </application>

</manifest>