<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only network use: TMDB metadata lookups and optional Sentry crash
         reports. Declared explicitly instead of relying on it arriving via
         manifest merge from a dependency (e.g. Ktor/Coil/Sentry). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only: lets an "offline" screen retry when the network returns (#249). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- EPIC 5 (new-episode notifications): runtime-requested on API 33+ from
         MainActivity on first app open (see its doc comment); a no-op
         declaration on older APIs where the permission doesn't exist. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Device Backup (EPIC 51 WS6, ADR 0034): backup is ON at the manifest level and OFF in the data.
         The agent offers the library database only when the person has turned Device Backup on, and
         offers nothing else, ever (KSafe's secrets included). Before ADR 0034 this was allowBackup=false,
         which on targetSdk 31+ did not stop device-to-device transfer at all; the rules below now state
         what leaves the device on both paths. `fullBackupOnly`: there is no key-value backup to do. -->
    <application
        android:allowBackup="true"
        android:backupAgent=".backup.MuvissBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:fullBackupOnly="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:name=".MuvissApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Muviss">
        <activity
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth sign-in comes back here (ADR 0014). The scheme/host
                 must stay identical to `OAUTH_REDIRECT_URI` in
                 :core:sync's OAuthRedirect.kt and to
                 `additional_redirect_urls` in supabase/config.toml — XML
                 cannot reference the Kotlin constant, so all three move
                 together. singleTask (above) is what makes the redirect
                 reach the running app through onNewIntent rather than
                 starting a second instance on top of it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="muviss" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- "Watch next" home-screen widget (EPIC 22). Runs in this process,
             so it resolves ProgressApi from the Koin graph MuvissApplication
             started — the same route NewEpisodesWorker takes. -->
        <receiver
            android:exported="false"
            android:name=".widget.MuvissWidgetReceiver">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/muviss_widget_info" />
        </receiver>
    </application>

</manifest>