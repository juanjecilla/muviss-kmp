<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Shared container for the SQLite database (ADR 0014). The app target
	  carries the identical entry; both must be enabled on the App Group in
	  the Apple Developer portal before either target will sign. Until then
	  DatabaseFactory.ios.kt falls back to the app's Documents directory and
	  the widget shows an empty library — see docs/RELEASING.md.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.codingpit.muviss</string>
	</array>
</dict>
</plist>
