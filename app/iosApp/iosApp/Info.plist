<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The UI languages the app ships (EPIC 31). Without this iOS treats the
	     app as English-only: no Spanish UI, and no per-app language in Settings. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  EPIC 5 (new-episode notifications) background refresh, iOS side
	  (IosBackgroundRefresh.kt in app/shared's iosMain — mirrors
	  :app:androidApp's WorkManager-based NewEpisodesScheduler/Worker):
	  BGTaskScheduler requires every identifier a `register()` call uses to be
	  declared here up front, and `fetch` is the UIBackgroundModes flag Apple
	  documents for BGAppRefreshTask-based background app refresh.
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.codingpit.muviss.refresh</string>
	</array>
	<!--
	  The `muviss` custom scheme (ADR 0014). Two things arrive on it: the OAuth
	  redirect `muviss://auth-callback?code=…`, and the home-screen widget's
	  `.widgetURL` `muviss://title/<mediaId>` (MuvissWidget/WatchNextView.swift).
	  iOSApp.swift's .onOpenURL hands both to IosDeepLinks.handle.

	  The scheme has to stay identical to OAUTH_REDIRECT_URI in :core:sync's
	  OAuthRedirect.kt, to the auth-callback intent filter in
	  app/androidApp's manifest, and to additional_redirect_urls in
	  supabase/config.toml — a plist cannot reference the Kotlin constant, so
	  all four move together.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.codingpit.muviss</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>muviss</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>